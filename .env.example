# Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
AUTH_SECRET="generate-with: openssl rand -hex 32"
ADMIN_EMAILS="you@example.com"           # comma-separated; these accounts get the admin role
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET=""                           # bearer token for /api/cron (Vercel Cron sends it automatically)

# Brand / contact
NEXT_PUBLIC_BRAND_NAME="Busongo"
NEXT_PUBLIC_BRAND_SHORT="Busongo"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_ADDRESS="Lusaka, Zambia"

# Pricing (ZMW / month) and GRZ withholding tax %
NEXT_PUBLIC_PRICE_ADVANCED="199"
NEXT_PUBLIC_PRICE_PRO="349"
NEXT_PUBLIC_GRZ_WHT="15"

# Email (password reset). Without a key, emails are logged to the console.
RESEND_API_KEY=""
MAIL_FROM="Busongo <no-reply@example.com>"

# AI assistant (any OpenAI-compatible API)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Mobile Money aggregator. Leave empty to use the built-in sandbox.
PAYMENT_CHARGE_URL=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
