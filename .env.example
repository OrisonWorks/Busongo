# Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
AUTH_SECRET="generate-with: openssl rand -hex 32"
ADMIN_EMAILS="you@example.com"           # comma-separated; these accounts get the admin role
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET=""                           # bearer token for /api/cron (Vercel Cron sends it automatically)

# Brand / contact
NEXT_PUBLIC_BRAND_NAME="Busongo"
NEXT_PUBLIC_BRAND_SHORT="Busongo"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_ADDRESS="Lusaka, Zambia"

# Pricing (ZMW / month) and GRZ withholding tax %
NEXT_PUBLIC_PRICE_ADVANCED="199"
NEXT_PUBLIC_PRICE_PRO="349"
NEXT_PUBLIC_GRZ_WHT="15"

# Email (password reset). Without a key, emails are logged to the console.
RESEND_API_KEY=""
MAIL_FROM="Busongo <no-reply@example.com>"

# AI assistant (any OpenAI-compatible API)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Mobile Money aggregator. Leave empty to use the built-in sandbox.
PAYMENT_CHARGE_URL=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# NEAR (wallet sign-in, stablecoin payments, on-chain proofs). Testnet unless NEAR_NETWORK="mainnet".
NEAR_NETWORK="testnet"
NEAR_SIGNIN_RECIPIENT="busongo"
# Account that anchors proof hashes on NEAR Social. Leave empty to keep proofs off-chain only.
NEAR_ACCOUNT_ID=""
NEAR_PRIVATE_KEY=""
# Account that receives USDC/USDT. Stablecoin checkout is hidden until this (or NEAR_ACCOUNT_ID) is set.
NEAR_MERCHANT_ACCOUNT=""

# Show crypto pages (markets, Kwacha & Stablecoins) in the app and navigation. Off by default; crypto stays in the backtester as demo data.
NEXT_PUBLIC_ENABLE_CRYPTO=""
# Allow USDC/USDT checkout on NEAR mainnet (testnet only otherwise). Get SEC Zambia / BoZ clearance first.
NEAR_MAINNET_PAYMENTS=""
# Plans, pricing and checkout. Off by default: Busongo is free for everyone.
NEXT_PUBLIC_ENABLE_PAYMENTS=""
# Wallet sign-in and the Busongo Ledger (records on NEAR). On by default; set to "0" to switch off.
NEXT_PUBLIC_ENABLE_WEB3=""
# Simulated paper trading. Off by default.
NEXT_PUBLIC_ENABLE_PAPER_TRADING=""
